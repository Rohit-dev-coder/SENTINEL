.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.gpg
*.asc
settings-security.xml

# ---------------------------------------------------------------
# Java / Maven
# ---------------------------------------------------------------
*.class
*.war
*.nar
*.ear

# Build output: ignore everything inside each target/ folder EXCEPT the built jars
# (so the jar files stay in the repository). Remove the "!" line to ignore jars again.
**/target/*
!**/target/*.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Test and coverage output
jacoco.exec
*.exec
hs_err_pid*
*.hprof
*.dump
*.dumpstream
coverage/

