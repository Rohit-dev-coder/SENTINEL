# Copy to .env and replace every value before running docker-compose
POSTGRES_PASSWORD=change-me
GRAFANA_PASSWORD=change-me
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-bytes
# Shared key for the admin API (X-Admin-Key header)
ADMIN_API_KEY=change-me
# Dashboard sign-in and session signing (SESSION_SECRET: 32+ random chars)
UI_ADMIN_USER=admin
UI_ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
