package com.sentinel.gateway.ratelimit;

public class RateLimitResult {
    
    private final boolean allowed;
    private final int remaining;
    private final long resetAt;       // Unix timestamp when limit resets
    private final int limit;          // Max requests configured

    public RateLimitResult(
            boolean allowed, int remaining, 
            long resetAt, int limit) {
        this.allowed = allowed;
        this.remaining = remaining;
        this.resetAt = resetAt;
        this.limit = limit;
    }

    // Getters
    public boolean isAllowed() { return allowed; }
    public int getRemaining() { return remaining; }
    public long getResetAt() { return resetAt; }
    public int getLimit() { return limit; }

    // Factory methods
    public static RateLimitResult allowed(
            int remaining, long resetAt, int limit) {
        return new RateLimitResult(true, remaining, resetAt, limit);
    }

    public static RateLimitResult denied(
            long resetAt, int limit) {
        return new RateLimitResult(false, 0, resetAt, limit);
    }
}
