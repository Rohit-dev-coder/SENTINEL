## 5.3 Rate Limiter Core — Algorithm Implementations

### Algorithm 1: TokenBucketRateLimiter.java

```java
package com.sentinel.gateway.ratelimit.algorithm;

import com.sentinel.gateway.ratelimit.RateLimiter;
import com.sentinel.gateway.ratelimit.RateLimitResult;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.data.redis.core.script.RedisScript;
import org.springframework.stereotype.Component;
import java.util.Collections;
import java.util.List;

@Component
public class TokenBucketRateLimiter implements RateLimiter {

    @Autowired
    private RedisTemplate<String, String> redisTemplate;

    @Autowired
    private RedisScript<List<Long>> tokenBucketScript;

    @Override
    public RateLimitResult isAllowed(
            String key, int maxRequests, int windowSeconds) {

        String redisKey = "rl:token:" + key;

        // Calculate refill rate: tokens per second
        double refillRate = (double) maxRequests / windowSeconds;

        long now = System.currentTimeMillis();

        // Execute Lua script atomically
        List<Long> result = redisTemplate.execute(
            tokenBucketScript,
            Collections.singletonList(redisKey),
            String.valueOf(maxRequests),          // bucket capacity
            String.valueOf(refillRate),            // tokens per second
            String.valueOf(now),                   // current timestamp
            String.valueOf(windowSeconds)          // TTL for key
        );

        if (result == null || result.isEmpty()) {
            return RateLimitResult.denied(
                now + (windowSeconds * 1000L), maxRequests);
        }

        boolean allowed = result.get(0) == 1L;
        int remaining = result.get(1).intValue();
        long resetAt = now + (windowSeconds * 1000L);

        if (allowed) {
            return RateLimitResult.allowed(
                remaining, resetAt, maxRequests);
        } else {
            return RateLimitResult.denied(
                resetAt, maxRequests);
        }
    }
}
```

### Algorithm 2: SlidingWindowLogRateLimiter.java

```java
package com.sentinel.gateway.ratelimit.algorithm;

import com.sentinel.gateway.ratelimit.RateLimiter;
import com.sentinel.gateway.ratelimit.RateLimitResult;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.data.redis.core.script.RedisScript;
import org.springframework.stereotype.Component;
import java.util.Collections;
import java.util.List;

@Component
public class SlidingWindowLogRateLimiter implements RateLimiter {

    @Autowired
    private RedisTemplate<String, String> redisTemplate;

    @Autowired
    private RedisScript<List<Long>> slidingWindowLogScript;

    @Override
    public RateLimitResult isAllowed(
            String key, int maxRequests, int windowSeconds) {

        String redisKey = "rl:swlog:" + key;

        long now = System.currentTimeMillis();
        long windowStart = now - (windowSeconds * 1000L);

        List<Long> result = redisTemplate.execute(
            slidingWindowLogScript,
            Collections.singletonList(redisKey),
            String.valueOf(now),                   // current timestamp
            String.valueOf(windowStart),           // window start
            String.valueOf(maxRequests),            // max allowed
            String.valueOf(windowSeconds)           // TTL
        );

        if (result == null || result.isEmpty()) {
            return RateLimitResult.denied(
                now + (windowSeconds * 1000L), maxRequests);
        }

        boolean allowed = result.get(0) == 1L;
        int currentCount = result.get(1).intValue();
        int remaining = Math.max(0, maxRequests - currentCount);
        long resetAt = now + (windowSeconds * 1000L);

        if (allowed) {
            return RateLimitResult.allowed(
                remaining, resetAt, maxRequests);
        } else {
            return RateLimitResult.denied(
                resetAt, maxRequests);
        }
    }
}
