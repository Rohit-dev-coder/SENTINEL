### Algorithm 3: FixedWindowCounterRateLimiter.java

```java
package com.sentinel.gateway.ratelimit.algorithm;

import com.sentinel.gateway.ratelimit.RateLimiter;
import com.sentinel.gateway.ratelimit.RateLimitResult;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.data.redis.core.script.RedisScript;
import org.springframework.stereotype.Component;
import java.util.Collections;
import java.util.List;

@Component
public class FixedWindowCounterRateLimiter implements RateLimiter {

    @Autowired
    private RedisTemplate<String, String> redisTemplate;

    @Autowired
    private RedisScript<List<Long>> fixedWindowScript;

    @Override
    public RateLimitResult isAllowed(
            String key, int maxRequests, int windowSeconds) {

        long now = System.currentTimeMillis();

        // Calculate current window ID
        long windowId = now / (windowSeconds * 1000L);

        String redisKey = "rl:fixed:" + key + ":" + windowId;

        // Calculate when this window resets
        long windowEnd = (windowId + 1) * (windowSeconds * 1000L);

        List<Long> result = redisTemplate.execute(
            fixedWindowScript,
            Collections.singletonList(redisKey),
            String.valueOf(maxRequests),
            String.valueOf(windowSeconds)
        );

        if (result == null || result.isEmpty()) {
            return RateLimitResult.denied(
                windowEnd, maxRequests);
        }

        long currentCount = result.get(0);
        boolean allowed = currentCount <= maxRequests;
        int remaining = Math.max(0,
            (int) (maxRequests - currentCount));

        if (allowed) {
            return RateLimitResult.allowed(
                remaining, windowEnd, maxRequests);
        } else {
            return RateLimitResult.denied(
                windowEnd, maxRequests);
        }
    }
}
```

### Algorithm 4: SlidingWindowCounterRateLimiter.java

```java
package com.sentinel.gateway.ratelimit.algorithm;

import com.sentinel.gateway.ratelimit.RateLimiter;
import com.sentinel.gateway.ratelimit.RateLimitResult;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.data.redis.core.script.RedisScript;
import org.springframework.stereotype.Component;
import java.util.Arrays;
import java.util.List;

@Component
public class SlidingWindowCounterRateLimiter implements RateLimiter {

    @Autowired
    private RedisTemplate<String, String> redisTemplate;

    @Autowired
    private RedisScript<List<Long>> slidingWindowCounterScript;

    @Override
    public RateLimitResult isAllowed(
            String key, int maxRequests, int windowSeconds) {

        long now = System.currentTimeMillis();
        long windowSizeMs = windowSeconds * 1000L;

        // Current and previous window IDs
        long currentWindowId = now / windowSizeMs;
        long previousWindowId = currentWindowId - 1;

        String currentKey = "rl:sw:" + key + ":" + currentWindowId;
        String previousKey = "rl:sw:" + key + ":" + previousWindowId;

        // Position in current window (0.0 to 1.0)
        double position = (double) (now % windowSizeMs) / windowSizeMs;

        List<Long> result = redisTemplate.execute(
            slidingWindowCounterScript,
            Arrays.asList(currentKey, previousKey),
            String.valueOf(maxRequests),
            String.valueOf(position),
            String.valueOf(windowSeconds)
        );

        if (result == null || result.isEmpty()) {
            return RateLimitResult.denied(
                now + windowSizeMs, maxRequests);
        }

        boolean allowed = result.get(0) == 1L;
        long weightedCount = result.get(1);
        int remaining = Math.max(0,
            (int) (maxRequests - weightedCount));
        long resetAt = (currentWindowId + 1) * windowSizeMs;

        if (allowed) {
            return RateLimitResult.allowed(
                remaining, resetAt, maxRequests);
        } else {
            return RateLimitResult.denied(
                resetAt, maxRequests);
        }
    }
}
```

## 5.4 Redis Lua Scripts (Complete Code)

### Lua Script 1: Token Bucket

```lua
-- token_bucket.lua
-- KEYS[1] = rate limit key
-- ARGV[1] = bucket capacity (max tokens)
-- ARGV[2] = refill rate (tokens per second)
-- ARGV[3] = current timestamp (milliseconds)
-- ARGV[4] = TTL in seconds

local key = KEYS[1]
local capacity = tonumber(ARGV[1])
local refillRate = tonumber(ARGV[2])
local now = tonumber(ARGV[3])
local ttl = tonumber(ARGV[4])

-- Get current bucket state
local bucket = redis.call('HMGET', key, 'tokens', 'lastRefill')
local tokens = tonumber(bucket[1])
local lastRefill = tonumber(bucket[2])

-- Initialize if first request
if tokens == nil then
    tokens = capacity
    lastRefill = now
end

-- Calculate tokens to add since last refill
local elapsed = (now - lastRefill) / 1000.0  -- convert ms to seconds
local tokensToAdd = elapsed * refillRate
tokens = math.min(capacity, tokens + tokensToAdd)

-- Try to consume a token
local allowed = 0
local remaining = 0

if tokens >= 1 then
    tokens = tokens - 1
    allowed = 1
    remaining = math.floor(tokens)
else
    allowed = 0
    remaining = 0
end

-- Save bucket state
redis.call('HMSET', key, 
    'tokens', tostring(tokens), 
    'lastRefill', tostring(now))
redis.call('EXPIRE', key, ttl * 2)

return {allowed, remaining}
```

### Lua Script 2: Sliding Window Log

```lua
-- sliding_window_log.lua
-- KEYS[1] = rate limit key (sorted set)
-- ARGV[1] = current timestamp
-- ARGV[2] = window start timestamp
-- ARGV[3] = max requests
-- ARGV[4] = TTL in seconds

local key = KEYS[1]
local now = tonumber(ARGV[1])
local windowStart = tonumber(ARGV[2])
local maxRequests = tonumber(ARGV[3])
local ttl = tonumber(ARGV[4])

-- Remove expired entries (outside the window)
redis.call('ZREMRANGEBYSCORE', key, '-inf', windowStart)

-- Count current requests in window
local currentCount = redis.call('ZCARD', key)

local allowed = 0

if currentCount < maxRequests then
    -- Add current request timestamp
    redis.call('ZADD', key, now, tostring(now) .. ':' .. math.random(100000))
    allowed = 1
    currentCount = currentCount + 1
end

-- Set expiry on the key
redis.call('EXPIRE', key, ttl * 2)

return {allowed, currentCount}
```

### Lua Script 3: Fixed Window Counter

```lua
-- fixed_window_counter.lua
-- KEYS[1] = rate limit key (includes window ID)
-- ARGV[1] = max requests
-- ARGV[2] = TTL in seconds

local key = KEYS[1]
local maxRequests = tonumber(ARGV[1])
local ttl = tonumber(ARGV[2])

-- Increment counter
local currentCount = redis.call('INCR', key)

-- Set TTL on first request in this window
if currentCount == 1 then
    redis.call('EXPIRE', key, ttl)
end

return {currentCount}
```

### Lua Script 4: Sliding Window Counter

```lua
-- sliding_window_counter.lua
-- KEYS[1] = current window key
-- KEYS[2] = previous window key
-- ARGV[1] = max requests
-- ARGV[2] = position in current window (0.0 to 1.0)
-- ARGV[3] = TTL in seconds

local currentKey = KEYS[1]
local previousKey = KEYS[2]
local maxRequests = tonumber(ARGV[1])
local position = tonumber(ARGV[2])
local ttl = tonumber(ARGV[3])

-- Get counts for current and previous windows
local currentCount = tonumber(redis.call('GET', currentKey) or '0')
local previousCount = tonumber(redis.call('GET', previousKey) or '0')

-- Calculate weighted count
local weightedCount = previousCount * (1 - position) + currentCount

local allowed = 0

if weightedCount < maxRequests then
    -- Increment current window counter
    redis.call('INCR', currentKey)
    redis.call('EXPIRE', currentKey, ttl * 2)
    allowed = 1
    weightedCount = weightedCount + 1
end

return {allowed, math.floor(weightedCount)}
```

