package com.sentinel.gateway.ratelimit;

/**
 * Strategy Pattern interface for rate limiting algorithms.
 * Each algorithm implements this interface.
 * The correct algorithm is selected based on per-endpoint config.
 */
public interface RateLimiter {

    /**
     * Check if the request is allowed under the rate limit.
     *
     * @param key       Unique key: "tenant:method:path"
     * @param maxRequests Maximum requests allowed in the window
     * @param windowSeconds Duration of the rate limit window
     * @return RateLimitResult with allowed, remaining, resetAt
     */
    RateLimitResult isAllowed(
        String key, int maxRequests, int windowSeconds);
}
